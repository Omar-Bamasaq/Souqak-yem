# Git Ignore Rules for Suqaq Beta

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (Sensitive Data)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database data (Local Storage)
backend/mongodb_data/

# Logs
backend/logs/*.log
npm-debug.log*

# User Uploads (Local media)
backend/uploads/
!backend/uploads/.gitkeep

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build outputs
frontend/dist/
frontend/build/
