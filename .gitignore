# Git Ignore Rules for Suqaq Beta

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (Sensitive Data)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!**/.env.example
*.pem
*.key

# Database data (Local Storage)
backend/mongodb_data/
**/mongodb_data/
**/database-backups/
**/db-backups/
**/mongo-backups/

# Logs
backend/logs/*.log
npm-debug.log*
logs/
**/logs/
*.log
*buildlog*

# User Uploads (Local media)
uploads/
backend/uploads/
!backend/uploads/.gitkeep
!backend/uploads/categories/
!backend/uploads/categories/*
backend/private_uploads/
**/private_uploads/
**/private-documents/
**/private_documents/
**/documents/private/
**/identity-documents/
**/identity_documents/
**/identity-docs/
**/identity_docs/
**/identity/
**/identities/
**/deeds/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build outputs
frontend/dist/
frontend/build/
**/dist/
**/build/
backend/exports/production-data/
**/production-data/
**/backups/
**/backup/
*.dump
*.bson
*.archive
*.sql
*.zip
*.7z
*.sqlite
*.sqlite3
*.db
*.tmp
*.temp
*.bak
*.backup
*.old
*.tar.gz
*~
