# Copy this template to the repository root as .env before running Docker Compose.
# Replace empty secret values with newly generated production credentials.

MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_ORIGIN=https://souqak-yem.com,https://www.souqak-yem.com
FRONTEND_URL=https://souqak-yem.com
PORT=5000

# The Mongo provisioner verifies app-account authentication before the backend
# starts. Existing volumes are retained;
# volumes with unknown existing users fail closed for manual repair.
#
# All MongoDB usernames must contain only letters, digits, dot, underscore,
# tilde, or hyphen. Passwords must be at least 32 base64url characters
# (letters, digits, underscore, or hyphen). This avoids Compose interpolation
# and MongoDB URI escaping issues. Generate new credentials for every deployment.

# Optional Web Push configuration
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Optional Gmail App Password credentials; configure only the accounts in use.
EMAIL_USER=
EMAIL_PASS=
EMAIL_USER_1=
EMAIL_PASS_1=
EMAIL_USER_2=
EMAIL_PASS_2=
EMAIL_USER_3=
EMAIL_PASS_3=
EMAIL_USER_4=
EMAIL_PASS_4=
EMAIL_USER_5=
EMAIL_PASS_5=
EMAIL_USER_6=
EMAIL_PASS_6=
EMAIL_USER_7=
EMAIL_PASS_7=
EMAIL_USER_8=
EMAIL_PASS_8=
ADMIN_EMAIL=

SENTRY_DSN=
LOG_LEVEL=info
